{
	"nodes":[
		{"id":"g_sagt","type":"group","x":0,"y":0,"width":1000,"height":650,"label":""},
		{"id":"h_sagt","type":"text","x":30,"y":30,"width":940,"height":80,"color":"5","text":"## Sagt"},
		{"id":"sagt_0","type":"text","x":30,"y":130,"width":300,"height":150,"color":"5","text":"„Guck mal, da ist ein Hund!“\n\n*Familie*"},
		{"id":"sagt_1","type":"text","x":350,"y":130,"width":300,"height":150,"color":"5","text":"„Papa, wer sind die alle?“\n\n*Familie*"},
		{"id":"sagt_2","type":"text","x":670,"y":130,"width":300,"height":150,"color":"5","text":"„Wir gucken gleich weiter, ja?“\n\n*Familie*"},
		{"id":"sagt_3","type":"text","x":30,"y":300,"width":300,"height":150,"color":"5","text":"„Boah, sind die riesig.“\n\n*Studentin*"},
		{"id":"sagt_4","type":"text","x":350,"y":300,"width":300,"height":150,"color":"5","text":"„Mach mal ein Foto von mir davor.“\n\n*Studentin*"},
		{"id":"sagt_5","type":"text","x":670,"y":300,"width":300,"height":150,"color":"5","text":"„Was ist daran so besonders?“\n\n*Studentin*"},
		{"id":"sagt_6","type":"text","x":30,"y":470,"width":300,"height":150,"color":"5","text":"„Is there anything in English?“\n\n*Touristin*"},
		{"id":"sagt_7","type":"text","x":350,"y":470,"width":300,"height":150,"color":"5","text":"„We still have to see the Raphael.“\n\n*Touristin*"},
		{"id":"g_denkt","type":"group","x":1040,"y":0,"width":1000,"height":650,"label":""},
		{"id":"h_denkt","type":"text","x":1070,"y":30,"width":940,"height":80,"color":"6","text":"## Denkt"},
		{"id":"denkt_0","type":"text","x":1070,"y":130,"width":300,"height":150,"color":"6","text":"„Wenn Ella fragt, weiß ich die Antwort nicht.“\n\n*Familie*"},
		{"id":"denkt_1","type":"text","x":1390,"y":130,"width":300,"height":150,"color":"6","text":"„Wie lange hält sie noch durch?“\n\n*Familie*"},
		{"id":"denkt_2","type":"text","x":1710,"y":130,"width":300,"height":150,"color":"6","text":"„Warum sind die so breit?“\n\n*Studentin*"},
		{"id":"denkt_3","type":"text","x":1070,"y":300,"width":300,"height":150,"color":"6","text":"„Ist das jetzt was Besonderes oder nur alt?“\n\n*Studentin*"},
		{"id":"denkt_4","type":"text","x":1390,"y":300,"width":300,"height":150,"color":"6","text":"„Lohnt sich hier der Audioguide?“\n\n*Studentin*"},
		{"id":"denkt_5","type":"text","x":1710,"y":300,"width":300,"height":150,"color":"6","text":"„Das ist doch die Hochzeit zu Kana.“\n\n*Touristin*"},
		{"id":"denkt_6","type":"text","x":1390,"y":470,"width":300,"height":150,"color":"6","text":"„Bestimmt hingen die mal in einer Kirche.“\n\n*Touristin*"},
		{"id":"g_tut","type":"group","x":0,"y":690,"width":1000,"height":650,"label":""},
		{"id":"h_tut","type":"text","x":30,"y":1230,"width":940,"height":80,"color":"2","text":"## Tut"},
		{"id":"tut_0","type":"text","x":670,"y":1060,"width":300,"height":150,"color":"2","text":"liest Ella den Wandtext vor, bricht nach zwei Sätzen ab\n\n*Familie*"},
		{"id":"tut_1","type":"text","x":350,"y":1060,"width":300,"height":150,"color":"2","text":"sucht mit Ella Tiere und Kinder im Bild\n\n*Familie*"},
		{"id":"tut_2","type":"text","x":30,"y":1060,"width":300,"height":150,"color":"2","text":"geht nach ein paar Minuten weiter\n\n*Familie*"},
		{"id":"tut_3","type":"text","x":670,"y":890,"width":300,"height":150,"color":"2","text":"macht ein Foto für die Gruppe\n\n*Studentin*"},
		{"id":"tut_4","type":"text","x":350,"y":890,"width":300,"height":150,"color":"2","text":"liest nur den Bildtitel\n\n*Studentin*"},
		{"id":"tut_5","type":"text","x":30,"y":890,"width":300,"height":150,"color":"2","text":"sucht ein Schild auf Englisch\n\n*Touristin*"},
		{"id":"tut_6","type":"text","x":350,"y":720,"width":300,"height":150,"color":"2","text":"setzt sich auf die Bank und schaut von weitem\n\n*Touristin*"},
		{"id":"g_fuehlt","type":"group","x":1040,"y":690,"width":1000,"height":650,"label":""},
		{"id":"h_fuehlt","type":"text","x":1070,"y":1230,"width":940,"height":80,"color":"3","text":"## Fühlt"},
		{"id":"fuehlt_0","type":"text","x":1710,"y":1060,"width":300,"height":150,"color":"3","text":"unter Druck, weil Ella ungeduldig wird\n\n*Familie*"},
		{"id":"fuehlt_1","type":"text","x":1390,"y":1060,"width":300,"height":150,"color":"3","text":"froh über jedes Detail, das Ella fesselt\n\n*Familie*"},
		{"id":"fuehlt_2","type":"text","x":1070,"y":1060,"width":300,"height":150,"color":"3","text":"beeindruckt von der Größe\n\n*Studentin*"},
		{"id":"fuehlt_3","type":"text","x":1710,"y":890,"width":300,"height":150,"color":"3","text":"gelangweilt, wenn es nach Schulstoff klingt\n\n*Studentin*"},
		{"id":"fuehlt_4","type":"text","x":1390,"y":890,"width":300,"height":150,"color":"3","text":"ausgeschlossen, weil sie die Texte nicht lesen kann\n\n*Touristin*"},
		{"id":"fuehlt_5","type":"text","x":1070,"y":890,"width":300,"height":150,"color":"3","text":"müde nach vielen Sälen\n\n*Touristin*"},
		{"id":"fuehlt_6","type":"text","x":1710,"y":720,"width":300,"height":150,"color":"3","text":"freut sich, wenn sie eine Bibelgeschichte erkennt\n\n*Touristin*"},
		{"id":"g_pains","type":"group","x":0,"y":1440,"width":1000,"height":650,"label":""},
		{"id":"h_pains","type":"text","x":30,"y":1470,"width":940,"height":80,"color":"1","text":"## Pains"},
		{"id":"pains_0","type":"text","x":30,"y":1570,"width":300,"height":150,"color":"1","text":"Texte zu lang zum Vorlesen\n\n*Familie*"},
		{"id":"pains_1","type":"text","x":350,"y":1570,"width":300,"height":150,"color":"1","text":"nichts zum Mitmachen für Kinder\n\n*Familie*"},
		{"id":"pains_2","type":"text","x":670,"y":1570,"width":300,"height":150,"color":"1","text":"Kunst-Fachsprache\n\n*Studentin*"},
		{"id":"pains_3","type":"text","x":30,"y":1740,"width":300,"height":150,"color":"1","text":"Audioguide erst ausleihen müssen\n\n*Studentin*"},
		{"id":"pains_4","type":"text","x":350,"y":1740,"width":300,"height":150,"color":"1","text":"veraltete Technik an Medienstationen\n\n*Studentin*"},
		{"id":"pains_5","type":"text","x":670,"y":1740,"width":300,"height":150,"color":"1","text":"Texte nur auf Deutsch\n\n*Touristin*"},
		{"id":"pains_6","type":"text","x":30,"y":1910,"width":300,"height":150,"color":"1","text":"kleine Schrift\n\n*Touristin*"},
		{"id":"pains_7","type":"text","x":350,"y":1910,"width":300,"height":150,"color":"1","text":"zu wenig Sitzplätze\n\n*Touristin*"},
		{"id":"g_gains","type":"group","x":1040,"y":1440,"width":1000,"height":650,"label":""},
		{"id":"h_gains","type":"text","x":1070,"y":1470,"width":940,"height":80,"color":"4","text":"## Gains"},
		{"id":"gains_0","type":"text","x":1070,"y":1570,"width":300,"height":150,"color":"4","text":"gemeinsam etwas entdecken\n\n*Familie*"},
		{"id":"gains_1","type":"text","x":1390,"y":1570,"width":300,"height":150,"color":"4","text":"Einstieg ohne Lesen\n\n*Familie*"},
		{"id":"gains_2","type":"text","x":1710,"y":1570,"width":300,"height":150,"color":"4","text":"etwas, das Ella später erzählt\n\n*Familie*"},
		{"id":"gains_3","type":"text","x":1070,"y":1740,"width":300,"height":150,"color":"4","text":"eine überraschende Geschichte zum Weitererzählen\n\n*Studentin*"},
		{"id":"gains_4","type":"text","x":1390,"y":1740,"width":300,"height":150,"color":"4","text":"ein Moment, den man teilen kann\n\n*Studentin*"},
		{"id":"gains_5","type":"text","x":1710,"y":1740,"width":300,"height":150,"color":"4","text":"alles auch auf Englisch\n\n*Touristin*"},
		{"id":"gains_6","type":"text","x":1070,"y":1910,"width":300,"height":150,"color":"4","text":"in Ruhe sitzen und schauen\n\n*Touristin*"},
		{"id":"persona","type":"text","x":800,"y":550,"width":440,"height":240,"text":"### Museumsbesucher*in\nsteht vor dem Cuccina-Zyklus in der Gemäldegalerie Alte Meister, kennt sich mit Kunst kaum aus, hat wenig Zeit"},
		{"id":"g_typen","type":"group","x":-760,"y":115,"width":600,"height":1110,"label":"Annäherung über drei Besuchertypen"},
		{"id":"typ_0","type":"text","x":-730,"y":145,"width":540,"height":330,"text":"**Familie mit Kind**\nDaniel (39) mit Tochter Ella (7)\n\n- Ausflug am Wochenende, Ellas erster Museumsbesuch\n- nach anderthalb Stunden ist die Luft raus\n- Texte vorlesen dauert zu lange\n- „Wenn sie fragt und ich es nicht weiß, gehen wir weiter.“"},
		{"id":"typ_1","type":"text","x":-730,"y":505,"width":540,"height":330,"text":"**Studentin**\nAylin (23), zeigt zwei Freundinnen Dresden\n\n- will vor allem die Highlights sehen\n- kaum Vorwissen zu Kunst und Bibel\n- Handy immer dabei, teilt gern Fotos\n- „Wenn das eine gute Story ist, schick ich's in die Gruppe.“"},
		{"id":"typ_2","type":"text","x":-730,"y":865,"width":540,"height":330,"text":"**Touristin**\nElaine (64) aus Manchester, Städtereise\n\n- kommt wegen der Sixtinischen Madonna\n- spricht kein Deutsch\n- müde Füße, sucht Sitzplätze\n- „Who are all these people?“"}
	],
	"edges":[
		{"id":"e_typen","fromNode":"g_typen","fromSide":"right","toNode":"persona","toSide":"left"}
	]
}