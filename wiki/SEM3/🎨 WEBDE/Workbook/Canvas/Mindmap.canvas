{
	"nodes":[
		{"id":"zentrum","type":"text","x":-280,"y":-200,"width":560,"height":400,"text":"# Cuccina-Zyklus\nvier zusammengehörige Gemälde von Paolo Veronese, um 1571\n![[3-madonna-der-familie-cuccina.jpeg]]"},
		{"id":"l_2","type":"text","x":1420,"y":-1187,"width":370,"height":64,"color":"5","text":"Familie betet Maria an"},
		{"id":"l_3","type":"text","x":1420,"y":-1111,"width":370,"height":64,"color":"5","text":"Säulen trennen Familie und Heilige"},
		{"id":"s_1","type":"text","x":970,"y":-1153,"width":360,"height":72,"color":"5","text":"**Madonna der Familie Cuccina**"},
		{"id":"l_5","type":"text","x":1420,"y":-1021,"width":370,"height":64,"color":"5","text":"Könige bringen Geschenke"},
		{"id":"l_6","type":"text","x":1420,"y":-945,"width":370,"height":64,"color":"5","text":"Sinnbild für Gastfreundschaft"},
		{"id":"s_4","type":"text","x":970,"y":-987,"width":360,"height":72,"color":"5","text":"**Anbetung der Könige**"},
		{"id":"l_8","type":"text","x":1420,"y":-855,"width":370,"height":64,"color":"5","text":"Jesus verwandelt Wasser in Wein"},
		{"id":"l_9","type":"text","x":1420,"y":-779,"width":370,"height":64,"color":"5","text":"Festessen wie im Saal"},
		{"id":"s_7","type":"text","x":970,"y":-821,"width":360,"height":72,"color":"5","text":"**Hochzeit zu Kana**"},
		{"id":"l_11","type":"text","x":1420,"y":-689,"width":370,"height":64,"color":"5","text":"Jesus trägt sein Kreuz"},
		{"id":"l_12","type":"text","x":1420,"y":-613,"width":370,"height":64,"color":"5","text":"erschöpft auf einem Knie"},
		{"id":"s_10","type":"text","x":970,"y":-655,"width":360,"height":72,"color":"5","text":"**Kreuztragung**"},
		{"id":"l_14","type":"text","x":1420,"y":-523,"width":370,"height":64,"color":"5","text":"je über 4 m breit"},
		{"id":"l_15","type":"text","x":1420,"y":-447,"width":370,"height":64,"color":"5","text":"nur 1,65–2 m hoch"},
		{"id":"s_13","type":"text","x":970,"y":-489,"width":360,"height":72,"color":"5","text":"**Format**"},
		{"id":"m_0","type":"text","x":450,"y":-845,"width":400,"height":120,"color":"5","text":"## 🖼️ Die vier Gemälde\ndrei Bibelszenen, ein Familienbild"},
		{"id":"l_18","type":"text","x":1420,"y":-267,"width":370,"height":64,"color":"4","text":"reich durch Stoffhandel"},
		{"id":"l_19","type":"text","x":1420,"y":-191,"width":370,"height":64,"color":"4","text":"wohlhabende Bürger, kein Adel"},
		{"id":"s_17","type":"text","x":970,"y":-233,"width":360,"height":72,"color":"4","text":"**Kaufleute**"},
		{"id":"l_21","type":"text","x":1420,"y":-101,"width":370,"height":64,"color":"4","text":"ließ sich neben Heilige malen"},
		{"id":"l_22","type":"text","x":1420,"y":-25,"width":370,"height":64,"color":"4","text":"oft geändert, in Absprache"},
		{"id":"s_20","type":"text","x":970,"y":-67,"width":360,"height":72,"color":"4","text":"**zeigt sich im Bild**"},
		{"id":"l_24","type":"text","x":1420,"y":65,"width":370,"height":64,"color":"4","text":"Namen oft unsicher"},
		{"id":"l_25","type":"text","x":1420,"y":141,"width":370,"height":64,"color":"4","text":"gestreifte Kinderkleider"},
		{"id":"s_23","type":"text","x":970,"y":99,"width":360,"height":72,"color":"4","text":"**viele Kinder**"},
		{"id":"l_27","type":"text","x":1420,"y":231,"width":370,"height":64,"color":"4","text":"rotes Samtkleid, Bildmitte"},
		{"id":"l_28","type":"text","x":1420,"y":307,"width":370,"height":64,"color":"4","text":"Vater handelte mit rotem Farbstoff"},
		{"id":"s_26","type":"text","x":970,"y":265,"width":360,"height":72,"color":"4","text":"**Zuanna Cuccina**"},
		{"id":"m_16","type":"text","x":450,"y":-8,"width":400,"height":120,"color":"4","text":"## 👪 Familie Cuccina\nließ die Bilder malen"},
		{"id":"l_31","type":"text","x":1420,"y":487,"width":370,"height":64,"color":"1","text":"Blau ist verblasst"},
		{"id":"l_32","type":"text","x":1420,"y":563,"width":370,"height":64,"color":"1","text":"Grün ist braun geworden"},
		{"id":"l_33","type":"text","x":1420,"y":639,"width":370,"height":64,"color":"1","text":"Violett wirkt rotbraun"},
		{"id":"l_34","type":"text","x":1420,"y":715,"width":370,"height":64,"color":"1","text":"Schutzlack ist nachgedunkelt"},
		{"id":"s_30","type":"text","x":970,"y":597,"width":360,"height":72,"color":"1","text":"**haben sich verändert**"},
		{"id":"l_36","type":"text","x":1420,"y":805,"width":370,"height":64,"color":"1","text":"Rot aus Mexiko"},
		{"id":"l_37","type":"text","x":1420,"y":881,"width":370,"height":64,"color":"1","text":"Blau aus Halbedelstein"},
		{"id":"l_38","type":"text","x":1420,"y":957,"width":370,"height":64,"color":"1","text":"Venedig: Zentrum des Farbhandels"},
		{"id":"s_35","type":"text","x":970,"y":877,"width":360,"height":72,"color":"1","text":"**teure Farben**"},
		{"id":"l_40","type":"text","x":1420,"y":1047,"width":370,"height":64,"color":"1","text":"Röntgen zeigt Korrekturen"},
		{"id":"l_41","type":"text","x":1420,"y":1123,"width":370,"height":64,"color":"1","text":"Infrarot zeigt Vorzeichnung"},
		{"id":"s_39","type":"text","x":970,"y":1081,"width":360,"height":72,"color":"1","text":"**Blick unter die Farbe**"},
		{"id":"m_29","type":"text","x":450,"y":827.6666666666665,"width":400,"height":120,"color":"1","text":"## 🎨 Die Farben\nkostbar und heute verändert"},
		{"id":"l_44","type":"text","x":-1790,"y":-1152,"width":370,"height":64,"color":"3","text":"Festessen und Bälle"},
		{"id":"l_45","type":"text","x":-1790,"y":-1076,"width":370,"height":64,"color":"3","text":"Musik und Theater"},
		{"id":"s_43","type":"text","x":-1330,"y":-1118,"width":360,"height":72,"color":"3","text":"**Wofür der Saal da war**"},
		{"id":"l_47","type":"text","x":-1790,"y":-986,"width":370,"height":64,"color":"3","text":"gemalt für den Blick von unten"},
		{"id":"l_48","type":"text","x":-1790,"y":-910,"width":370,"height":64,"color":"3","text":"genaue Plätze unsicher"},
		{"id":"s_46","type":"text","x":-1330,"y":-952,"width":360,"height":72,"color":"3","text":"**Bilder hingen hoch**"},
		{"id":"l_50","type":"text","x":-1790,"y":-820,"width":370,"height":64,"color":"3","text":"von rechts nach links lesen"},
		{"id":"l_51","type":"text","x":-1790,"y":-744,"width":370,"height":64,"color":"3","text":"in Laufrichtung der Gäste"},
		{"id":"s_49","type":"text","x":-1330,"y":-786,"width":360,"height":72,"color":"3","text":"**Geschichte zum Herumgehen**"},
		{"id":"l_53","type":"text","x":-1790,"y":-654,"width":370,"height":64,"color":"3","text":"Palazzo Barbarigo"},
		{"id":"l_54","type":"text","x":-1790,"y":-578,"width":370,"height":64,"color":"3","text":"ähnlicher Saal noch erhalten"},
		{"id":"s_52","type":"text","x":-1330,"y":-620,"width":360,"height":72,"color":"3","text":"**zum Vergleich**"},
		{"id":"l_56","type":"text","x":-1790,"y":-488,"width":370,"height":64,"color":"3","text":"am Canal Grande in Venedig"},
		{"id":"l_57","type":"text","x":-1790,"y":-412,"width":370,"height":64,"color":"3","text":"heißt heute Palazzo Papadopoli"},
		{"id":"l_58","type":"text","x":-1790,"y":-336,"width":370,"height":64,"color":"3","text":"Saal später umgebaut"},
		{"id":"s_55","type":"text","x":-1330,"y":-416,"width":360,"height":72,"color":"3","text":"**Palast der Familie**"},
		{"id":"m_42","type":"text","x":-850,"y":-802.4,"width":400,"height":120,"color":"3","text":"## 🏛️ Der Festsaal\nfür ihn wurden die Bilder gemalt"},
		{"id":"s_60","type":"text","x":-1330,"y":-156,"width":360,"height":72,"color":"6","text":"**1571: gemalt in Venedig**"},
		{"id":"s_61","type":"text","x":-1330,"y":-72,"width":360,"height":72,"color":"6","text":"**1645: an den Herzog von Modena**"},
		{"id":"s_62","type":"text","x":-1330,"y":12,"width":360,"height":72,"color":"6","text":"**1746: Kauf für Dresden**"},
		{"id":"s_63","type":"text","x":-1330,"y":96,"width":360,"height":72,"color":"6","text":"**2013–17: restauriert**"},
		{"id":"s_64","type":"text","x":-1330,"y":180,"width":360,"height":72,"color":"6","text":"**2018: Ausstellung mit Medienstationen**"},
		{"id":"s_65","type":"text","x":-1330,"y":264,"width":360,"height":72,"color":"6","text":"**heute: Gemäldegalerie Dresden**"},
		{"id":"m_59","type":"text","x":-850,"y":30,"width":400,"height":120,"color":"6","text":"## 🧭 Der Weg der Bilder\nvon Venedig nach Dresden"},
		{"id":"l_68","type":"text","x":-1790,"y":438,"width":370,"height":64,"color":"2","text":"lebte 1528–1588"},
		{"id":"l_69","type":"text","x":-1790,"y":514,"width":370,"height":64,"color":"2","text":"Zyklus auf seinem Höhepunkt"},
		{"id":"s_67","type":"text","x":-1330,"y":472,"width":360,"height":72,"color":"2","text":"**Paolo Veronese**"},
		{"id":"l_71","type":"text","x":-1790,"y":604,"width":370,"height":64,"color":"2","text":"Vorrat an Vorlage-Zeichnungen"},
		{"id":"l_72","type":"text","x":-1790,"y":680,"width":370,"height":64,"color":"2","text":"Kopf aus alter Zeichnung übernommen"},
		{"id":"s_70","type":"text","x":-1330,"y":638,"width":360,"height":72,"color":"2","text":"**Werkstatt**"},
		{"id":"l_74","type":"text","x":-1790,"y":770,"width":370,"height":64,"color":"2","text":"malte schnell"},
		{"id":"l_75","type":"text","x":-1790,"y":846,"width":370,"height":64,"color":"2","text":"billige Grundschicht, teure Farbe oben"},
		{"id":"l_76","type":"text","x":-1790,"y":922,"width":370,"height":64,"color":"2","text":"Gegenfarben: Rosa auf Grün"},
		{"id":"s_73","type":"text","x":-1330,"y":842,"width":360,"height":72,"color":"2","text":"**Malweise**"},
		{"id":"l_78","type":"text","x":-1790,"y":1012,"width":370,"height":64,"color":"2","text":"1674: „niemand seinesgleichen“"},
		{"id":"l_79","type":"text","x":-1790,"y":1088,"width":370,"height":64,"color":"2","text":"Meister der Bildkomposition"},
		{"id":"s_77","type":"text","x":-1330,"y":1046,"width":360,"height":72,"color":"2","text":"**Ruf**"},
		{"id":"m_66","type":"text","x":-850,"y":725.5,"width":400,"height":120,"color":"2","text":"## 🖌️ Der Maler Veronese\nmalte sie mit seiner Werkstatt"}
	],
